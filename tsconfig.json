{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@love-letter-core/*": [
        "./packages/love-letter-core/src/*"
      ],
      "@protocol/*": [
        "./packages/protocol/src/*"
      ]
    }
  },
  "include": [
    "src/games/love-letter/**/*.ts",
    "src/games/love-letter/**/*.tsx",
    "packages/love-letter-core/src/**/*.ts",
    "packages/protocol/src/**/*.ts"
  ]
}
